{
  "name": "lich-truc-cdha",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "vitest run",
    "worker:dev": "wrangler dev --local --persist-to=.wrangler/state --port 8787",
    "worker:types": "wrangler types src/worker/env.d.ts",
    "d1:local": "wrangler d1 migrations apply lich-truc-cdha --local",
    "db:migrate:postgres": "node scripts/migrate-d1-to-postgres.mjs",
    "deploy:dry": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "docx": "^9.7.1",
    "html-to-image": "^1.11.13",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "pg": "^8.16.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "vitest": "^2.1.8",
    "wrangler": "^4.24.0"
  }
}
